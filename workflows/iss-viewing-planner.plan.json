{
  "schema_version": "0.2",
  "kind": "ExecutionPlan",
  "inputs": {
    "request": {
      "required": true,
      "schema": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "location": {
            "type": "string"
          },
          "start_time": {
            "type": "string"
          },
          "reminder_minutes": {
            "type": "integer"
          }
        },
        "required": [],
        "additionalProperties": false,
        "title": "Viewing request",
        "description": "Use {} for Raleigh defaults. Optional location coordinates, start_time ('now' or zoned ISO timestamp), and reminder_minutes.",
        "default": {}
      }
    }
  },
  "nodes": {
    "prepare_request": {
      "kind": "AgentNode",
      "label": "Validate the viewing request",
      "model": {
        "connection_id": "92f2b659-564b-57c5-bdb2-6adf7a031df7",
        "id": "claude-opus-5-5"
      },
      "inputs": {
        "request": {
          "schema": {
            "type": "object",
            "properties": {
              "latitude": {
                "type": "number"
              },
              "longitude": {
                "type": "number"
              },
              "location": {
                "type": "string"
              },
              "start_time": {
                "type": "string"
              },
              "reminder_minutes": {
                "type": "integer"
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "expects": {
            "cardinality": "exactly_one",
            "shape": "value"
          }
        }
      },
      "outputs": {
        "parameters_ready": {
          "schema": {
            "type": "object",
            "properties": {
              "latitude": {
                "type": "number",
                "minimum": -85,
                "maximum": 85
              },
              "longitude": {
                "type": "number",
                "minimum": -177,
                "maximum": 177
              },
              "location": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "start_time": {
                "type": "string",
                "minLength": 1
              },
              "forecast_days": {
                "type": "integer",
                "const": 30
              },
              "weather_days": {
                "type": "integer",
                "const": 7
              },
              "reminder_minutes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1440
              }
            },
            "required": [
              "latitude",
              "longitude",
              "location",
              "start_time",
              "forecast_days",
              "weather_days",
              "reminder_minutes"
            ],
            "additionalProperties": false
          }
        },
        "links_ready": {
          "schema": {
            "type": "object",
            "properties": {
              "map_url": {
                "type": "string",
                "const": "https://dorrino-gif.github.io/iss-viewing-planner/"
              },
              "calendar_url": {
                "type": "string",
                "const": "https://dorrino-gif.github.io/iss-viewing-planner/data/all-passes.ics"
              },
              "summary": {
                "type": "string"
              }
            },
            "required": [
              "map_url",
              "calendar_url",
              "summary"
            ],
            "additionalProperties": false
          }
        },
        "blocked": {
          "schema": {
            "type": "object",
            "properties": {
              "summary": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "summary",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "orchestration": {
        "output_selection": "one_or_more",
        "evaluate_when": "all_required_inputs_produced"
      },
      "objective": "Validate the request with a short local script; use no network or business tools. Merge only supplied properties into these defaults: latitude 35.7796, longitude -78.6382, location 'Raleigh, NC', start_time 'now', reminder_minutes 15. Fixed deployment parameters are forecast_days=30 and weather_days=7. Verify finite latitude [-85,85], longitude [-177,177], nonempty location up to 80 characters without control characters, integer reminder_minutes [0,1440]. start_time must be 'now' or an ISO timestamp with a time zone. Use date -u for current time; reject dates more than one hour from now, because the approved workflow pairs fresh orbital elements and current weather. This version displays America/New_York time, so reject locations outside North Carolina (latitude 33.8..36.7, longitude -84.4..-75.4) rather than mislabeling time zones. Do not calculate, invent, or report any ISS pass times or weather. On invalid input select only blocked with summary and reason and no ready outputs. On valid input select BOTH parameters_ready containing precisely the eight deployment parameters and links_ready containing map_url='https://dorrino-gif.github.io/iss-viewing-planner/', calendar_url='https://dorrino-gif.github.io/iss-viewing-planner/data/all-passes.ics', and summary explaining these are destination links and this run has not published yet. Never emit blocked together with a ready output. The final plan outputs also require the deployment's completed output, so links are not a claim of successful publication."
    },
    "approve_publication": {
      "kind": "HumanInputNode",
      "label": "Approve updating the public map",
      "inputs": {
        "parameters": {
          "schema": {
            "type": "object",
            "properties": {
              "latitude": {
                "type": "number",
                "minimum": -85,
                "maximum": 85
              },
              "longitude": {
                "type": "number",
                "minimum": -177,
                "maximum": 177
              },
              "location": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "start_time": {
                "type": "string",
                "minLength": 1
              },
              "forecast_days": {
                "type": "integer",
                "const": 30
              },
              "weather_days": {
                "type": "integer",
                "const": 7
              },
              "reminder_minutes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1440
              }
            },
            "required": [
              "latitude",
              "longitude",
              "location",
              "start_time",
              "forecast_days",
              "weather_days",
              "reminder_minutes"
            ],
            "additionalProperties": false
          },
          "expects": {
            "cardinality": "exactly_one",
            "shape": "value"
          }
        }
      },
      "outputs": {
        "approved": {
          "schema": {
            "type": "object",
            "properties": {
              "decision": {
                "type": "string",
                "enum": [
                  "approved",
                  "rejected"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "decision",
              "summary"
            ],
            "additionalProperties": false
          }
        },
        "rejected": {
          "schema": {
            "type": "object",
            "properties": {
              "decision": {
                "type": "string",
                "enum": [
                  "approved",
                  "rejected"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "decision",
              "summary"
            ],
            "additionalProperties": false
          }
        },
        "expired": {
          "schema": {
            "type": "object",
            "properties": {
              "summary": {
                "type": "string"
              }
            },
            "required": [
              "summary"
            ],
            "additionalProperties": false
          }
        }
      },
      "orchestration": {
        "output_selection": "exactly_one",
        "evaluate_when": "all_required_inputs_produced"
      },
      "human_input": {
        "form_schema": {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "enum": [
                "approved",
                "rejected"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "decision",
            "summary"
          ],
          "additionalProperties": false,
          "title": "Publish a fresh ISS viewing forecast?",
          "description": "Approve fetching public ISS and seven-day weather data and committing the resulting 30-day predictions and calendar to dorrino-gif/iss-viewing-planner. GitHub Pages will publish those files. No personal calendar is connected. Enter a brief decision note in summary."
        },
        "deadline": {
          "after": "PT24H",
          "on_expiry": {
            "output": "expired",
            "value": {
              "summary": "Publication approval expired; the map was not updated."
            }
          }
        }
      }
    },
    "calculate_and_publish": {
      "kind": "DeploymentNode",
      "label": "Calculate, check, and publish viewing estimates",
      "deployment": {
        "id": "8b34d1c1-c2e2-49a5-a13c-3b4aafff5223"
      },
      "wait": {
        "for": "child_flow_run",
        "until": "terminal"
      },
      "inputs": {
        "parameters": {
          "schema": {
            "type": "object",
            "properties": {
              "latitude": {
                "type": "number",
                "minimum": -85,
                "maximum": 85
              },
              "longitude": {
                "type": "number",
                "minimum": -177,
                "maximum": 177
              },
              "location": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "start_time": {
                "type": "string",
                "minLength": 1
              },
              "forecast_days": {
                "type": "integer",
                "const": 30
              },
              "weather_days": {
                "type": "integer",
                "const": 7
              },
              "reminder_minutes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1440
              }
            },
            "required": [
              "latitude",
              "longitude",
              "location",
              "start_time",
              "forecast_days",
              "weather_days",
              "reminder_minutes"
            ],
            "additionalProperties": false
          },
          "expects": {
            "cardinality": "exactly_one",
            "shape": "value"
          }
        },
        "approval": {
          "schema": {
            "type": "object",
            "properties": {
              "decision": {
                "type": "string",
                "enum": [
                  "approved",
                  "rejected"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "decision",
              "summary"
            ],
            "additionalProperties": false
          },
          "expects": {
            "cardinality": "exactly_one",
            "shape": "value"
          }
        }
      },
      "outputs": {
        "completed": {
          "schema": {
            "type": "object"
          }
        },
        "failed": {
          "schema": {
            "type": "object"
          }
        },
        "cancelled": {
          "schema": {
            "type": "object"
          }
        },
        "crashed": {
          "schema": {
            "type": "object"
          }
        }
      },
      "orchestration": {
        "output_selection": "exactly_one",
        "evaluate_when": "all_required_inputs_produced"
      }
    }
  },
  "edges": [
    {
      "id": "request-to-prepare",
      "from": {
        "type": "plan_input",
        "input": "request"
      },
      "to": {
        "node": "prepare_request",
        "input": "request"
      }
    },
    {
      "id": "parameters-to-approval",
      "from": {
        "type": "node_output",
        "node": "prepare_request",
        "output": "parameters_ready"
      },
      "to": {
        "node": "approve_publication",
        "input": "parameters"
      }
    },
    {
      "id": "parameters-to-deployment",
      "from": {
        "type": "node_output",
        "node": "prepare_request",
        "output": "parameters_ready"
      },
      "to": {
        "node": "calculate_and_publish",
        "input": "parameters"
      }
    },
    {
      "id": "approval-to-deployment",
      "from": {
        "type": "node_output",
        "node": "approve_publication",
        "output": "approved"
      },
      "to": {
        "node": "calculate_and_publish",
        "input": "approval"
      }
    }
  ],
  "outputs": {
    "map": {
      "fields": {
        "links": {
          "schema": {
            "type": "object",
            "properties": {
              "map_url": {
                "type": "string",
                "const": "https://dorrino-gif.github.io/iss-viewing-planner/"
              },
              "calendar_url": {
                "type": "string",
                "const": "https://dorrino-gif.github.io/iss-viewing-planner/data/all-passes.ics"
              },
              "summary": {
                "type": "string"
              }
            },
            "required": [
              "map_url",
              "calendar_url",
              "summary"
            ],
            "additionalProperties": false
          },
          "source": {
            "type": "node_output",
            "node": "prepare_request",
            "output": "links_ready"
          }
        },
        "publication": {
          "schema": {
            "type": "object"
          },
          "source": {
            "type": "node_output",
            "node": "calculate_and_publish",
            "output": "completed"
          }
        }
      },
      "required": [
        "links",
        "publication"
      ]
    },
    "calendar": {
      "fields": {
        "links": {
          "schema": {
            "type": "object",
            "properties": {
              "map_url": {
                "type": "string",
                "const": "https://dorrino-gif.github.io/iss-viewing-planner/"
              },
              "calendar_url": {
                "type": "string",
                "const": "https://dorrino-gif.github.io/iss-viewing-planner/data/all-passes.ics"
              },
              "summary": {
                "type": "string"
              }
            },
            "required": [
              "map_url",
              "calendar_url",
              "summary"
            ],
            "additionalProperties": false
          },
          "source": {
            "type": "node_output",
            "node": "prepare_request",
            "output": "links_ready"
          }
        },
        "publication": {
          "schema": {
            "type": "object"
          },
          "source": {
            "type": "node_output",
            "node": "calculate_and_publish",
            "output": "completed"
          }
        }
      },
      "required": [
        "links",
        "publication"
      ]
    },
    "publication_status": {
      "fields": {
        "completed": {
          "schema": {
            "type": "object"
          },
          "source": {
            "type": "node_output",
            "node": "calculate_and_publish",
            "output": "completed"
          }
        }
      },
      "required": [
        "completed"
      ]
    }
  },
  "orchestration": {
    "limits": {
      "max_active_nodes": 1,
      "max_active_child_flow_runs": 1
    }
  }
}
